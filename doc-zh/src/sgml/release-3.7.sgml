   </listitem>

   <listitem>
    <!--
    2021-03-16 [f07fdb0]
    -->
    <para>增强收到启动包时的调试消息。（Tatsuo Ishii）</para>
   </listitem>

   <listitem>
    <!--
    2021-05-09 [9971171]
    2021-05-05 [96578bd]
    2021-05-04 [69f3c9b]
    2021-04-20 [6150d26]
    2021-04-20 [d5469da]
    2021-04-13 [b3bddbe]
    2021-02-20 [d9f25b8]
    -->
    <para>文档：增强文档。（Tatsuo Ishii, Bo Peng）</para>
   </listitem>
  </itemizedlist>
 </sect2>
</sect1>

<sect1 id="release-3-7-18">
