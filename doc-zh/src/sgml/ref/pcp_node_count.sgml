<!--
doc/src/sgml/ref/pcp_node_count.sgml
Pgpool-II documentation
-->

<refentry id="PCP-NODE-COUNT">
 <indexterm zone="pcp-node-count">
  <primary>pcp_node_count</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>pcp_node_count</refentrytitle>
  <manvolnum>1</manvolnum>
  <refmiscinfo>PCP Command</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>pcp_node_count</refname>
  <refpurpose>
   显示数据库节点的总数</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  <cmdsynopsis>
   <command>pcp_node_count</command>
   <arg rep="repeat"><replaceable>option</replaceable></arg>
  </cmdsynopsis>
 </refsynopsisdiv>

 <refsect1 id="R1-PCP-NODE-COUNT-1">
  <title>
   说明
  </title>
  <para>
   <command>pcp_node_count</command>
   显示在 <filename>pgpool.conf</filename> 中定义的数据库节点总数。它不区分节点状态（即附加/分离），所有节点均被计数。
  </para>
 </refsect1>

 <refsect1>
  <title>选项</title>
  <para>
   参见 <xref linkend="pcp-common-options">。
  </para>
 </refsect1>

 <refsect1>
  <title>示例</title>
  <para>
   以下是一个输出示例：
   <programlisting>
    $ pcp_node_count -p 11001
    Password:
    2
   </programlisting>
  </para>
 </refsect1>
</refentry>
