<!--
doc/src/sgml/ref/wd_cli.sgml
Pgpool-II documentation
-->

<refentry id="WD-CLI">
 <indexterm zone="wd-cli">
  <primary>wd_cli</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>wd_cli</refentrytitle>
  <manvolnum>1</manvolnum>
  <refmiscinfo>其他命令</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>wd_cli</refname>
  <refpurpose>
   用于外部健康检查系统集成的 Watchdog 命令行接口 (CLI) 工具。
  </refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  <cmdsynopsis>
   <command>wd_cli</command>
   <arg rep="repeat"><replaceable>操作</replaceable></arg>
   <arg rep="repeat"><replaceable>节点搜索选项</replaceable></arg>
   <arg rep="repeat"><replaceable>选项</replaceable></arg>
  </cmdsynopsis>
 </refsynopsisdiv>

 <refsect1 id="R1-WD-CLI-1">
  <title>描述</title>
  <para>
   <command>wd_cli</command>
   提供便捷易用的接口，用于与 watchdog 交互并执行与健康
   检查相关的节点操作。
  </para>
 </refsect1>

 <refsect1>
  <title>操作</title>
  <para>
   <variablelist>

    <varlistentry>
     <term><option>-i</option></term>
     <term><option>--info</option></term>
     <listitem>
      <para>
       根据节点搜索条件获取一个或多个节点的状态。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-I <replaceable class="parameter">NEW_STATUS</replaceable></option></term>
     <term><option>--inform=<replaceable class="parameter">NEW_STATUS</replaceable></option></term>
     <listitem>
      <para>
       更新 watchdog 节点状态。
	   允许值为 <literal>DEAD</literal> 和 <literal>ALIVE</literal>。
      </para>
     </listitem>
    </varlistentry>

   </variablelist>
  </para>
 </refsect1>

 <refsect1>
  <title>节点搜索选项</title>
  <para>
   <variablelist>

    <varlistentry>
     <term><option>-a </option></term>
     <term><option>--all</option></term>
     <listitem>
      <para>
       选择所有节点（仅与 <literal>--info</literal> 操作配合使用）
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-n <replaceable class="parameter">WATCHDOG_NODE_ID</replaceable></option></term>
     <term><option>--node-id=<replaceable class="parameter">WATCHDOG_NODE_ID</replaceable></option></term>
     <listitem>
      <para>
       通过 node_id 选择 watchdog 节点。
      </para>
     </listitem>
    </varlistentry>

	<varlistentry>
     <term><option>-N <replaceable class="parameter">NODE_NAME</replaceable></option></term>
     <term><option>--node-name=<replaceable class="parameter">NODE_NAME</replaceable></option></term>
     <listitem>
      <para>
       通过名称选择 watchdog 节点。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-H <replaceable class="parameter">HOSTNAME</replaceable></option></term>
     <term><option>--node-host=<replaceable class="parameter">HOSTNAME</replaceable></option></term>
     <listitem>
      <para>
       通过主机名选择 watchdog 节点。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-P <replaceable class="parameter">PORT_NO</replaceable></option></term>
     <term><option>--node-port=<replaceable class="parameter">PORT_NO</replaceable></option></term>
     <listitem>
      <para>
       通过端口号选择 watchdog 节点。
      </para>
     </listitem>
    </varlistentry>


   </variablelist>
  </para>
 </refsect1>

 <refsect1>
  <title>选项</title>
  <para>
   <variablelist>

    <varlistentry>
     <term><option>-k <replaceable class="parameter">KEY</replaceable></option></term>
     <term><option>--auth-key=<replaceable class="parameter">KEY</replaceable></option></term>
     <listitem>
      <para>
       Watchdog 认证密钥。
       指定 auth-key 将覆盖 <literal>pgpool.conf->wd_authkey</literal> 中的值。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-f <replaceable class="parameter">CONFIG_FILE</replaceable></option></term>
     <term><option>--config-file=<replaceable class="parameter">CONFIG_FILE</replaceable></option></term>
     <listitem>
      <para>
       指定 <literal>pgpool.conf</literal> 配置文件。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-s <replaceable class="parameter">SOCKET_DIR</replaceable></option></term>
     <term><option>--socket-dir=<replaceable class="parameter">SOCKET_DIR</replaceable></option></term>
     <listitem>
      <para>
       Watchdog IPC socket 目录路径。
       指定 socket-dir 将覆盖 <literal>pgpool.conf->wd_ipc_socket_dir</literal> 中的值。
      </para>
     </listitem>
    </varlistentry>

	<varlistentry>
     <term><option>-p <replaceable class="parameter">PORT_NO</replaceable></option></term>
     <term><option>--ipc-port=<replaceable class="parameter">PORT_NO</replaceable></option></term>
     <listitem>
      <para>
       Watchdog IPC socket 端口号。
       指定 ipc-port 将覆盖 <literal>pgpool.conf->wd_port</literal> 中的值。
      </para>
     </listitem>
    </varlistentry>


    <varlistentry>
     <term><option>-m <replaceable class="parameter">message_string</replaceable></option></term>
     <term><option>--message=<replaceable class="parameter">message_string</replaceable></option></term>
     <listitem>
      <para>
       与节点状态一起传递给 <productname>Pgpool-II</productname> 的可选消息字符串。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-v</option></term>
     <term><option>--verbose</option></term>
     <listitem>
      <para>
       启用详细输出。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-V</option></term>
     <term><option>--version</option></term>
     <listitem>
      <para>
       打印版本信息。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-d</option></term>
     <term><option>--debug</option></term>
     <listitem>
      <para>
       启用调试输出。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-h</option></term>
     <term><option>--help</option></term>
     <listitem>
      <para>
       打印 <literal>wd_cli</literal> 的帮助信息。
      </para>
     </listitem>
    </varlistentry>

   </variablelist>
  </para>
 </refsect1>

 <refsect1>
  <title>示例</title>
  <para>
   当配置了某个外部健康检查系统来监控 <productname>Pgpool-II</productname> 集群
   的健康状况并检测到某个节点故障时，可以使用 <literal>wd_cli</literal> 工具
   将此信息传递给 <productname>Pgpool-II</productname> 集群，以便采取相应的处理措施。

   <programlisting>
    # 通知 Pgpool-II 节点 RN-110 发生故障
    wd_cli --inform DEAD -N 'RN-110' -p 9001 -m 'Pgpool node with name RN-110 is not reachable'
   </programlisting>
   <programlisting>
    # 通知 Pgpool-II 节点 ID 10 发生故障
    wd_cli --inform DEAD -n 10 -m 'Pgpool node with ID 10 is not responding'
   </programlisting>
   类似地，通知 Pgpool-II 节点已恢复正常。
   <programlisting>
    # 通知 Pgpool-II 节点 ID 10 重新加入集群
    wd_cli --inform ALIVE -n 10 -m 'Pgpool node with ID 10 is reachable again'
   </programlisting>

    wd_cli 还可用于获取集群节点的当前状态。
   <programlisting>
    wd_cli -f simple_conf/watchdog/pgpool_wd1.conf --info -v --all

	Total Watchdog nodes configured for lifecheck:  2
	*****************
	Node ID:           0
	Node Status code   4
	Node Status:       LEADER
	Node Name:         localhost:9991 Linux localhost.localdomain
	Node Host:         localhost
	Node WD Port:      9001
	Node Pgpool Port:  9991

	Node ID:           1
	Node Status code   7
	Node Status:       STANDBY
	Node Name:         localhost:9992 Linux localhost.localdomain
	Node Host:         localhost
	Node WD Port:      9002
	Node Pgpool Port:  9992
   </programlisting>
  </para>
 </refsect1>

</refentry>
