<!--
    doc/src/sgml/ref/show_pool_version.sgml
    Pgpool-II 文档
  -->

<refentry id="SQL-SHOW-POOL-VERSION">
 <indexterm zone="sql-show-pool-version">
  <primary>SHOW POOL_VERSION</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>SHOW POOL_VERSION</refentrytitle>
  <manvolnum>1</manvolnum>
  <refmiscinfo>SQL - 语言语句</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>SHOW POOL_VERSION</refname>
  <refpurpose>
   显示包含
   <productname>Pgpool-II</productname> 发布版本号
   的字符串。
  </refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  <synopsis>
   SHOW POOL_VERSION
  </synopsis>
 </refsynopsisdiv>

 <refsect1>
  <title>说明</title>

  <para>
   <command>SHOW POOL_VERSION</command> 显示包含
   <productname>Pgpool-II</productname> 发布版本号
   的字符串。以下是一个示例会话：
   <programlisting>
    test=# show pool_version;
    pool_version
    --------------------------
    3.6.0 (subaruboshi)
    (1 row)
   </programlisting>

  </para>
 </refsect1>

</refentry>
