<!--
doc/src/sgml/ref/pcp_recovery_node.sgml
Pgpool-II documentation
-->

<refentry id="PCP-RECOVERY-NODE">
 <indexterm zone="pcp-recovery-node">
  <primary>pcp_recovery_node</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>pcp_recovery_node</refentrytitle>
  <manvolnum>1</manvolnum>
  <refmiscinfo>PCP Command</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>pcp_recovery_node</refname>
  <refpurpose>
   通过恢复机制将指定的后端节点附加到集群中</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  <cmdsynopsis>
   <command>pcp_recovery_node</command>
   <arg rep="repeat"><replaceable>options</replaceable></arg>
   <arg><replaceable>node_id</replaceable></arg>
  </cmdsynopsis>
 </refsynopsisdiv>

 <refsect1 id="R1-PCP-RECOVERY-NODE-1">
  <title>描述</title>
  <para>
   <command>pcp_recovery_node</command>
   通过恢复机制将指定的后端节点附加到集群。
   请参阅 <xref linkend="runtime-online-recovery"> 以设置 pgpool.conf 中必要的参数。
  </para>
 </refsect1>

 <refsect1>
  <title>选项</title>
  <para>
   <variablelist>

    <varlistentry>
     <term><option>-n <replaceable class="parameter">node_id</replaceable></option></term>
     <term><option>--node-id=<replaceable class="parameter">node_id</replaceable></option></term>
     <listitem>
      <para>
       后端节点的索引。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>其他选项</option></term>
     <listitem>
      <para>
       请参阅 <xref linkend="pcp-common-options">。
      </para>
     </listitem>
    </varlistentry>

   </variablelist>
  </para>
 </refsect1>

</refentry>
