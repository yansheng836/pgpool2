<!--
doc/src/sgml/ref/pgproto.sgml
Pgpool-II documentation
-->

<refentry id="PGPROTO">
 <indexterm zone="pgproto">
  <primary>pgproto</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>pgproto</refentrytitle>
  <manvolnum>1</manvolnum>
  <refmiscinfo>Other Commands</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>pgproto</refname>
  <refpurpose>
   测试 <productname>PostgreSQL</productname> 或任何理解前端/后端协议的其他服务器。
  </refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  <cmdsynopsis>
   <command>pgproto</command>
   <arg rep="repeat"><replaceable>option</replaceable></arg>
  </cmdsynopsis>
 </refsynopsisdiv>

 <refsect1 id="R1-PGPROTO-1">
  <title>描述</title>
  <para>
   <command>pgproto</command>
   测试 <productname>PostgreSQL</productname> 或任何理解前端/后端协议的其他服务器。
  </para>
 </refsect1>

 <refsect1>
  <title>选项</title>
  <para>
   <variablelist>
    <varlistentry>
     <term><option>-h <replaceable class="parameter">hostname</replaceable></option></term>
     <term><option>--hostname=<replaceable class="parameter">hostname</replaceable></option></term>
     <listitem>
      <para>
       运行服务器的机器的主机名。如果值以斜杠开头，则用作 Unix 域套接字的目录（默认：使用 Unix 域套接字）。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-p <replaceable class="parameter">port</replaceable></option></term>
     <term><option>--port=<replaceable class="parameter">port</replaceable></option></term>
     <listitem>
      <para>
       端口号（默认：5432）。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-u <replaceable class="parameter">username</replaceable></option></term>
     <term><option>--user=<replaceable class="parameter">username</replaceable></option></term>
     <listitem>
      <para>
       用户名（默认：操作系统用户名）。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-d <replaceable class="parameter">databasename</replaceable></option></term>
     <term><option>--database=<replaceable class="parameter">databasename</replaceable></option></term>
     <listitem>
      <para>
       数据库名（默认：与用户名相同）。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-f <replaceable class="parameter">filename</replaceable></option></term>
     <term><option>--proto-data-file=<replaceable class="parameter">filename</replaceable></option></term>
     <listitem>
      <para>
       描述要发送到 <productname>PostgreSQL</productname> 的消息数据的文本文件（默认：pgproto.data）。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-r <replaceable class="parameter">naptime</replaceable></option></term>
     <term><option>--read-nap=<replaceable class="parameter">naptime</replaceable></option></term>
     <listitem>
      <para>
       休眠时间，单位为微秒（默认：0）。
       大于 0 将使 pgproto 在从套接字每次读取数据之间休眠。
       这对于模拟慢速客户端非常有用。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-D</option></term>
     <term><option>--debug</option></term>
     <listitem>
      <para>
       启用调试消息。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-v</option></term>
     <term><option>--version</option></term>
     <listitem>
      <para>
       打印命令版本，然后退出。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-?</option></term>
     <term><option>--help</option></term>
     <listitem>
      <para>
       显示命令行参数的帮助信息，然后退出。
      </para>
     </listitem>
    </varlistentry>

   </variablelist>
  </para>
 </refsect1>

 <refsect1>
  <title>示例</title>
  <para>
   在下面的示例中，文件中的第一个字符（即 'Q'）
   表示 PostgreSQL 前端/后端协议中指定的消息类型。
  </para>
  <para>
   例外情况是 'Y'、'y'、'z' 和 's'。'Y' 从后端读取消息，
   直到收到 'Ready for query' 为止。
   'y' 在后端有消息时持续读取，如果在 1 秒内没有可用消息则停止。
   'Y' 用于等待 'Q'（简单查询）的回复，或在扩展查询的 'S'（sync）之后。
   'y' 可用于接收 'H'（flush）之后的消息。
   'z' 从后端读取 1 条消息。如果在 1 秒内没有消息到达，则 'z' 停止。
   如果要读取多条消息，可以重复使用 'z' 来控制消息数量。
   当您已经知道会有多少条回复消息时，'z' 对于 'H' 消息测试非常有用。
   's' 使 pgproto 睡眠指定的毫秒数。
  </para>
  <para>
   如果要在字符串数据类型中包含双引号（"），
   例如 "SELECT * FROM "aaa""，则可以使用 \（反斜杠）进行转义，如 ""SELECT * FROM "aaa""。

   也可以使用 \ 来创建跨多行的命令行。
   <programlisting>
    'Q'	"SELECT * FROM aaa \
    WHERE a = 1"
   </programlisting>
  </para>
  <para>
   如果您想使用 COPY 等命令，可以使用 "\n" 插入换行符。如下所示。
   <programlisting>
    'Q'	"COPY t1 FROM STDIN"
    'd'	"1\n"
    'd'	"2\n"
    'c'
    'Y'
   </programlisting>
  </para>
  <para>
   以下是输入文件的示例：
   <programlisting>
    #
    # 测试数据示例
    #
    'Q'	"SELECT * FROM aaa"
    'Y'
    'P'	"S1"	"BEGIN"	0
    'B'	""	"S1"	0	0	0
    'E'	""	0
    'C'	'S'	"S1"
    'P'	"foo"	"SELECT 1"	0
    'B'	"myportal"	"foo"	0	0	0
    'E'	"myportal"	0
    'P'	"S2"	"COMMIT"	0
    'B'	""	"S2"	0	0	0
    'E'	""	0
    'C'	'S'	"S2"
    'S'
    'Y'
    'X'
   </programlisting>
  </para>
  <para>
   以下是输出示例：
   <programlisting>
    $ pgproto -p 11000 -d test -f sample.data
    FE=> Query (query="SELECT * FROM aaa")
    <= BE RowDescription
    <= BE CommandComplete(SELECT 0)
    <= BE ReadyForQuery(I)
    FE=> Parse(stmt="S1", query="BEGIN")
    FE=> Bind(stmt="S1", portal="")
    FE=> Execute(portal="")
    FE=> Close(stmt="S1")
    FE=> Parse(stmt="foo", query="SELECT 1")
    FE=> Bind(stmt="foo", portal="myportal")
    FE=> Execute(portal="myportal")
    FE=> Parse(stmt="S2", query="COMMIT")
    FE=> Bind(stmt="S2", portal="")
    FE=> Execute(portal="")
    FE=> Close(stmt="S2")
    FE=> Sync
    <= BE ParseComplete
    <= BE BindComplete
    <= BE CommandComplete(BEGIN)
    <= BE CloseComplete
    <= BE ParseComplete
    <= BE BindComplete
    <= BE DataRow
    <= BE CommandComplete(SELECT 1)
    <= BE ParseComplete
    <= BE BindComplete
    <= BE CommandComplete(COMMIT)
    <= BE CloseComplete
    <= BE ReadyForQuery(I)
    FE=> Terminate
   </programlisting>
  </para>
  <para>
   其他示例数据文件：
  </para>
  <para>
   Copy
   <programlisting>
    #
    # 测试数据示例
    #

    # CopyIn
    #
    'Q'	"COPY t1 FROM STDIN"
    # CopyData
    'd'	"abc\n"
    # CopyDone
    'c'
    'Y'

    # CopyOut
    #
    'Q'	"COPY t1 TO STDOUT"
    'Y'

    #
    # Copy 失败情况
    #
    'Q'	"COPY t1 FROM STDIN"
    # CopyData
    'd'	"abc\n"
    # CopyFail
    'f'	"pgproto copy fail test"
    'Y'
    'X'
   </programlisting>
  </para>
  <para>
   函数调用
   <programlisting>
    #
    # 测试数据示例
    #

    # 函数调用 (lo_creat)
    # 来自 PostgreSQL 的 src/include/catalog/pg_proc.data
    # { oid => '957', descr => 'large object create',
    #  proname => 'lo_creat', provolatile => 'v', proparallel => 'u',
    #  prorettype => 'oid', proargtypes => 'int4', prosrc => 'be_lo_creat' },

    'F'	957	1	0	1	1	"0"	0
    'Y'
    'X'
   </programlisting>
  </para>
 </refsect1>

</refentry>
