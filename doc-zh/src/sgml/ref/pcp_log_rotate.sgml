<!--
doc/src/sgml/ref/pcp_logrotate_pgpool.sgml
Pgpool-II documentation
-->

<refentry id="PCP-LOG-ROTATE">
 <indexterm zone="pcp-log-rotate">
  <primary>pcp_log_rotate</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>pcp_log_rotate</refentrytitle>
  <manvolnum>1</manvolnum>
  <refmiscinfo>PCP Command</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>pcp_log_rotate</refname>
  <refpurpose>
   轮换 Pgpool-II 的日志文件</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  <cmdsynopsis>
   <command>pcp_log_rotate</command>
   <arg rep="repeat"><replaceable>options</replaceable></arg>
  </cmdsynopsis>
 </refsynopsisdiv>

 <refsect1 id="R1-PCP-LOG-ROTATE-1">
  <title>描述</title>
  <para>
   <command>pcp_log_rotate</command>
   用于轮换 Pgpool-II 的日志文件。
  </para>
 </refsect1>

 <refsect1>
  <title>选项</title>
  <para>
   <variablelist>

    <varlistentry>
     <term><option>-s <replaceable class="parameter">scope</replaceable></option></term>
     <term><option>--scope=<replaceable class="parameter">scope</replaceable></option></term>
     <listitem>
      <para>
       指定命令的作用范围。
      </para>
      <para>
       支持的命令作用范围如下（默认为 "local"）：
       <itemizedlist>
	<listitem><para>c, cluster：轮换集群中所有 Pgpool-II 节点的日志文件</para></listitem>
	<listitem><para>l, local：仅轮换本地 Pgpool-II 节点的日志文件</para></listitem>
       </itemizedlist>
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>其他选项</option></term>
     <listitem>
      <para>
       参见 <xref linkend="pcp-common-options">。
      </para>
     </listitem>
    </varlistentry>

   </variablelist>
  </para>
 </refsect1>

</refentry>
