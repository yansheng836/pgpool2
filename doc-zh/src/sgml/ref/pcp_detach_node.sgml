<!--
doc/src/sgml/ref/pcp_detach_node.sgml
Pgpool-II documentation
-->

<refentry id="PCP-DETACH-NODE">
 <indexterm zone="pcp-detach-node">
  <primary>pcp_detach_node</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>pcp_detach_node</refentrytitle>
  <manvolnum>1</manvolnum>
  <refmiscinfo>PCP Command</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>pcp_detach_node</refname>
  <refpurpose>
   将指定节点从 Pgpool-II 中分离。正在连接到 Pgpool-II 的现有连接将被强制断开。</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  <cmdsynopsis>
   <command>pcp_detach_node</command>
   <arg rep="repeat"><replaceable>options</replaceable></arg>
   <arg><replaceable>node_id</replaceable></arg>
   <arg><replaceable>gracefully</replaceable></arg>
  </cmdsynopsis>
 </refsynopsisdiv>

 <refsect1 id="R1-PCP-DETACH-NODE-1">
  <title>描述</title>
  <para>
   <command>pcp_detach_node</command> 将指定节点从
   <productname>Pgpool-II</productname> 中分离。如果已指定 <xref
   linkend="guc-failover-command"> 和/或 <xref
   linkend="guc-follow-primary-command">，它们也会一并执行。正在连接到
   <productname>Pgpool-II</productname> 的现有连接将被强制断开。
  </para>
  <para>
   <command>pcp_detach_node</command> 仅分离该节点，不会触碰该节点后面的后端运行进程。当管理员需要对
   <productname>PostgreSQL</productname> 节点进行维护时，此命令非常有用。管理员可以多次关闭或停止后端进程。
  </para>
  <para>
   重新附加已分离节点最安全的方式是先停止后端，然后执行 <xref linkend="pcp-recovery-node">。但是，如果您确定不存在复制延迟（或延迟将在稍后恢复），且该节点的角色（主节点/备节点）不会改变，您也可以使用 <xref linkend="pcp-attach-node">。
  </para>
 </refsect1>

 <refsect1>
  <title>选项</title>
  <para>
   <variablelist>

    <varlistentry>
     <term><option>-n <replaceable class="parameter">node_id</replaceable></option></term>
     <term><option>--node_id=<replaceable class="parameter">node_id</replaceable></option></term>
     <listitem>
      <para>
       要分离的后端节点的索引。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-g</option></term>
     <term><option>--gracefully</option></term>
     <listitem>
      <para>
       等待所有客户端断开连接后再执行（除非 client_idle_limit_in_recovery 为 -1 或 recovery_timeout 已超时）。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>其他选项</option></term>
     <listitem>
      <para>
       请参阅 <xref linkend="pcp-common-options">。
      </para>
     </listitem>
    </varlistentry>

   </variablelist>
  </para>
 </refsect1>

</refentry>
