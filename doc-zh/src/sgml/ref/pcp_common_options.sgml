<!--
doc/src/sgml/ref/pcp_common_options.sgml
Pgpool-II documentation
-->

<refentry id="PCP-COMMON-OPTIONS">
 <indexterm zone="pcp-common-options">
  <primary>pcp_common_options</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>pcp_common_options</refentrytitle>
  <manvolnum>1</manvolnum>
  <refmiscinfo>PCP Command</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>pcp_common_options</refname>
  <refpurpose>
   PCP 命令中使用的公共选项</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  <cmdsynopsis>
   <command>pcp_command</command>
   <arg rep="repeat"><replaceable>option</></arg>
  </cmdsynopsis>
 </refsynopsisdiv>

 <refsect1 id="R1-PCP-common-options-1">
  <title>
   描述
  </title>
  <para>
   所有 PCP 命令都有一些公共参数。大多数用于身份认证，其余的涉及详细模式、调试消息等。
  </para>
 </refsect1>

 <refsect1>
  <title>选项</title>

  <para>
   <variablelist>

    <varlistentry>
     <term><option>-h <replaceable class="parameter">hostname</replaceable></option></term>
     <term><option>--host=<replaceable class="parameter">hostname</replaceable></option></term>
     <listitem>
      <para>
       服务器运行所在机器的主机名。如果该值以斜杠开头，则将其用作 Unix 域套接字的目录。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-p <replaceable class="parameter">port</replaceable></option></term>
     <term><option>--port=<replaceable class="parameter">port</replaceable></option></term>
     <listitem>
      <para>
       PCP 端口号（默认："9898"）。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-U <replaceable class="parameter">username</replaceable></option></term>
     <term><option>--username=<replaceable class="parameter">username</replaceable></option></term>
     <listitem>
      <para>
       用于 PCP 身份认证的用户名（默认：操作系统用户名）。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-w</option></term>
     <term><option>--no-password</option></term>
     <listitem>
      <para>
       从不提示输入密码（应自动发生）。如果无法通过 <filename>.pcppass</filename> 文件获得密码，则连接尝试将失败。此选项对于没有用户来输入密码的批处理任务和脚本非常有用。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-W</option></term>
     <term><option>--password</option></term>
     <listitem>
      <para>
       强制提示输入密码。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-d</option></term>
     <term><option>--debug</option></term>
     <listitem>
      <para>
       启用调试消息。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-v</option></term>
     <term><option>--verbose</option></term>
     <listitem>
      <para>
       启用详细输出。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-V</option></term>
     <term><option>--version</option></term>
     <listitem>
      <para>
       打印命令版本号，然后退出。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-?</option></term>
     <term><option>--help</option></term>
     <listitem>
      <para>
       显示命令行参数的帮助信息，然后退出。
      </para>
     </listitem>
    </varlistentry>

   </variablelist>
  </para>

 </refsect1>

 <refsect1>
  <title>环境变量</title>

  <variablelist>
   <varlistentry>
    <term><envar>PCPPASSFILE</envar></term>

    <listitem>
     <para>
      指定 PCP 密码文件的路径。
     </para>
    </listitem>
   </varlistentry>

  </variablelist>

 </refsect1>

</refentry>
