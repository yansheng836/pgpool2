doc/src/sgml/ref/pgpool.sgml
Pgpool-II documentation
-->

<refentry id="pgpool">
 <indexterm zone="pgpool">
  <primary>pgpool</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>pgpool</refentrytitle>
  <manvolnum>8</manvolnum>
  <refmiscinfo>Server Commands</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>pgpool</refname>
  <refpurpose>
   <productname>Pgpool-II</productname> 主服务器</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  <cmdsynopsis>
   <command>pgpool</command>
   <arg rep="repeat"><replaceable>option</replaceable></arg>
  </cmdsynopsis>
  <cmdsynopsis>
   <command>pgpool</command>
   <arg rep="repeat"><replaceable>option</replaceable></arg>
   <arg choice="plain"><replaceable>stop</replaceable></arg>
  </cmdsynopsis>

  <cmdsynopsis>
   <command>pgpool</command>
   <arg rep="repeat"><replaceable>option</replaceable></arg>
   <arg choice="plain"><replaceable>reload</replaceable></arg>
  </cmdsynopsis>

 </refsynopsisdiv>

 <refsect1 id="R8-PGPOOL-8">
  <title>描述</title>
  <para>
   <productname>Pgpool-II</productname> 主服务器
  </para>
 </refsect1>

 <refsect1>
  <title>用法</title>
  <para>
   <command>pgpool</command> 以三种模式运行：启动、停止和重载。
   如果未指定 stop 或 reload，则默认为启动模式。
  </para>
 </refsect1>

 <refsect1>
  <title>通用选项</title>
  <para>
   以下是三种模式通用的选项。

   <variablelist>

    <varlistentry>
     <term><option>-a <replaceable class="parameter">hba_config_file</replaceable></option></term>
     <term><option>--hba-file=<replaceable class="parameter">hba_config_file</replaceable></option></term>
     <listitem>
      <para>
       设置 <filename>pool_hba.conf</filename> 配置文件的路径。
       如果文件未放置在标准位置，则必须指定此选项。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-f <replaceable class="parameter">config_file</replaceable></option></term>
     <term><option>--config-file=<replaceable class="parameter">config_file</replaceable></option></term>
     <listitem>
      <para>
       设置 <filename>pgpool.conf</filename> 配置文件的路径。
       如果文件未放置在标准位置，则必须指定此选项。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-F <replaceable class="parameter">pc_config_file</replaceable></option></term>
     <term><option>--pcp-file=<replaceable class="parameter">pcp_config_file</replaceable></option></term>
     <listitem>
      <para>
       设置 <filename>pcp.conf</filename> 配置文件的路径。
       如果文件未放置在标准位置，则必须指定此选项。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-k <replaceable class="parameter">key_file</replaceable></option></term>
     <term><option>--key-file=<replaceable class="parameter">key_file</replaceable></option></term>
     <listitem>
      <para>
       设置 <filename>.pgpoolkey</filename> 文件的路径。
       如果使用 AES256 加密密码且文件未放置在标准位置，则必须指定此选项。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-h</option></term>
     <term><option>--help</option></term>
     <listitem>
      <para>
       打印帮助信息。
      </para>
     </listitem>
    </varlistentry>

   </variablelist>
  </para>

 </refsect1>

 <refsect1>

  <title>启动 <productname>Pgpool-II</productname> 主服务器</title>
  <para>
   以下是启动模式的选项。

   <variablelist>

    <varlistentry>
     <term><option>-d</option></term>
     <term><option>--debug</option></term>
     <listitem>
      <para>
       以调试模式运行 <productname>Pgpool-II</productname>。
       会产生大量调试信息。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-n</option></term>
     <term><option>--dont-detach</option></term>
     <listitem>
      <para>
       不以后台守护进程模式运行，不脱离控制终端。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-x</option></term>
     <term><option>--debug-assertions</option></term>
     <listitem>
      <para>
       启用各种断言检查，用于调试辅助功能。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-C</option></term>
     <term><option>--clear-oidmaps</option></term>
     <listitem>
      <para>
       当 <xref linkend="guc-memqcache-method"> 设置为
	<varname>memcached</varname> 时，清除查询缓存的 oidmap。
      </para>
      <para>
       如果 memqcache_method 为 <varname>shmem</varname>，<productname>Pgpool-II</productname>
       在启动时总会丢弃 oidmap，因此此选项在此情况下不需要。
      </para>
     </listitem>
    </varlistentry>

    <varlistentry>
     <term><option>-D</option></term>
     <term><option>--discard-status</option></term>
     <listitem>
      <para>
       丢弃 <filename>pgpool_status</filename> 文件，不恢复上次状态。
      </para>
      <caution>
       <para>
       此选项仅供开发者测试使用，不应在其他场景中使用。
       如果 <filename>pgpool_status</filename> 被意外删除，<productname>Pgpool-II</productname> 可能进入脑裂状态（存在多个主服务器）。
       </para>
      </caution>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1>

  <title>停止 <productname>Pgpool-II</productname> 主服务器</title>
  <para>
   以下是停止模式的选项。

   <variablelist>

    <varlistentry>
     <term><option>-m <replaceable class="parameter">shutdown_mode</replaceable></option></term>
     <term><option>--mode=<replaceable class="parameter">shutdown_mode</replaceable></option></term>
     <listitem>
      <para>
       停止 <productname>Pgpool-II</productname>。
       <varname>shutdown_mode</varname> 可以是 <literal>smart</literal>、<literal>fast</literal>
       或 <literal>immediate</literal>。如果指定 <literal>smart</literal>，
       <productname>Pgpool-II</productname> 会等待所有客户端断开连接后再停止。
       如果指定 <literal>fast</literal> 或 <literal>immediate</literal>，
       <productname>Pgpool-II</productname> 将立即停止，不等待客户端断开连接。
       在当前实现中，<literal>fast</literal> 和 <literal>immediate</literal> 没有区别。
      </para>
     </listitem>
    </varlistentry>

   </variablelist>
  </para>
 </refsect1>

 <refsect1>
  <title>重新加载 <productname>Pgpool-II</productname> 配置文件</title>
  <para>
   重新加载 <productname>Pgpool-II</productname> 的配置文件。
   重载模式无特定选项，通用选项同样适用。
  </para>
 </refsect1>

</refentry>
