      <entry>192.168.100.52</entry>
     </row>
     <row>
      <entry>server3</entry>
      <entry>192.168.100.53</entry>
     </row>
    </tbody>
   </tgroup>
  </table>
  <table id="example-cluster-table-postgresql-config">
   <title>PostgreSQL 版本与配置</title>
   <tgroup cols="3">
